rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function bounded(n) { return request.query.limit != null && request.query.limit <= n; }
    function ideaPath(id) { return /databases/$(database)/documents/ideas/$(id); }
    function roomPath(id) { return /databases/$(database)/documents/rooms/$(id); }
    function owner(id) { return signedIn() && get(ideaPath(id)).data.authorId == request.auth.uid; }
    function member(id) { return signedIn() && request.auth.uid in get(roomPath(id)).data.memberIds; }
    function canPin() {
      return signedIn() && get(/databases/$(database)/documents/moderators/$(request.auth.uid)).data.canPin == true;
    }
    function named(data) {
      return signedIn() && data.authorId == request.auth.uid
        && data.authorName == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.displayName;
    }

    // Pin authority is granted in the Firebase console, never by a nickname or client write.
    match /moderators/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /settings/community {
      allow get: if true;
      allow list, delete: if false;
      allow create, update: if canPin()
        && request.resource.data.keys().hasOnly(['pinnedIdeaId', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && request.resource.data.pinnedIdeaId is string
        && (request.resource.data.pinnedIdeaId == ''
          || (request.resource.data.pinnedIdeaId.size() <= 128
            && request.resource.data.pinnedIdeaId.matches('^[A-Za-z0-9_-]+$')
            && exists(ideaPath(request.resource.data.pinnedIdeaId))));
    }
    match /profiles/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, delete: if false;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 20
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 20;
    }

    match /ideas/{id} {
      allow get: if true;
      allow list: if bounded(20);
      allow create: if named(request.resource.data)
        && request.resource.data.keys().hasOnly(['title', 'body', 'topic', 'authorId', 'authorName', 'createdAt', 'lastActivityAt', 'interestCount', 'contributionCount', 'lastContributionId', 'participantCount', 'lastChatAt', 'lastChatMessageId', 'postType', 'refinementCount', 'lastRefinementId'])
        && request.resource.data.get('postType', 'idea') == 'idea'
        && request.resource.data.get('refinementCount', 0) == 0
        && request.resource.data.get('lastRefinementId', '') == ''
        && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 100
        && request.resource.data.body is string && request.resource.data.body.size() <= 2000
        && request.resource.data.topic in ['나의 다음 일', '아이의 내일', '생활 속 생각', '엉뚱한 상상']
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastActivityAt == request.time
        && request.resource.data.interestCount == 0
        && request.resource.data.contributionCount == 0
        && request.resource.data.lastContributionId == ''
        && request.resource.data.get('participantCount', 1) == 1
        && request.resource.data.get('lastChatAt', null) == null
        && request.resource.data.get('lastChatMessageId', '') == '';

      function contentChange() {
        let next = request.resource.data;
        return resource.data.authorId == request.auth.uid
          && next.diff(resource.data).affectedKeys().hasOnly(['title', 'body', 'topic', 'updatedAt'])
          && next.title is string && next.title.size() >= 1 && next.title.size() <= 100
          && next.body is string && next.body.size() <= 2000
          && next.topic in ['나의 다음 일', '아이의 내일', '생활 속 생각', '엉뚱한 상상']
          && next.updatedAt == request.time
          && (next.title == resource.data.title || !exists(roomPath(id)) || getAfter(roomPath(id)).data.title == next.title);
      }
      function noticeChange() {
        return canPin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['postType'])
          && request.resource.data.postType in ['idea', 'notice'];
      }
      function refinementChange() {
        let next = request.resource.data;
        let path = /databases/$(database)/documents/ideas/$(id)/refinements/$(next.lastRefinementId);
        let event = /databases/$(database)/documents/ideas/$(id)/activities/$('r_' + next.lastRefinementId);
        return resource.data.get('postType', 'idea') != 'notice'
          && next.diff(resource.data).affectedKeys().hasOnly(['refinementCount', 'lastRefinementId', 'lastActivityAt'])
          && next.lastRefinementId is string && next.lastRefinementId.size() > 0
          && next.refinementCount == resource.data.get('refinementCount', 0) + 1
          && next.lastActivityAt == request.time
          && !exists(path) && getAfter(path).data.authorId == request.auth.uid
          && getAfter(path).data.createdAt == request.time && getAfter(event).data.createdAt == request.time;
      }
      function interestChange() {
        let path = /databases/$(database)/documents/ideas/$(id)/interests/$(request.auth.uid);
        let event = /databases/$(database)/documents/ideas/$(id)/activities/$('i_' + request.auth.uid);
        let next = request.resource.data;
        return next.diff(resource.data).affectedKeys().hasOnly(['interestCount', 'lastActivityAt'])
          && next.interestCount >= 0
          && (
            (!exists(path) && existsAfter(path) && next.interestCount == resource.data.interestCount + 1
              && ((!exists(event) && getAfter(event).data.createdAt == request.time && next.lastActivityAt == request.time)
                || (exists(event) && next.lastActivityAt == resource.data.lastActivityAt)))
            || (exists(path) && !existsAfter(path) && next.interestCount == resource.data.interestCount - 1
              && next.lastActivityAt == resource.data.lastActivityAt)
          );
      }
      function contributionChange() {
        let next = request.resource.data;
        let path = /databases/$(database)/documents/ideas/$(id)/contributions/$(next.lastContributionId);
        let event = /databases/$(database)/documents/ideas/$(id)/activities/$('c_' + next.lastContributionId);
        return next.diff(resource.data).affectedKeys().hasOnly(['contributionCount', 'lastContributionId', 'lastActivityAt'])
          && next.lastContributionId is string && next.lastContributionId.size() > 0
          && next.contributionCount == resource.data.contributionCount + 1
          && next.lastActivityAt == request.time
          && !exists(path) && getAfter(path).data.authorId == request.auth.uid
          && getAfter(path).data.createdAt == request.time
          && getAfter(event).data.createdAt == request.time;
      }
      function participantChange() {
        return member(id)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantCount'])
          && request.resource.data.participantCount == getAfter(roomPath(id)).data.memberIds.size();
      }
      function discussionChange() {
        let next = request.resource.data;
        let message = getAfter(/databases/$(database)/documents/rooms/$(id)/messages/$(next.lastChatMessageId));
        return member(id)
          && next.diff(resource.data).affectedKeys().hasOnly(['participantCount', 'lastChatAt', 'lastChatMessageId'])
          && next.participantCount == getAfter(roomPath(id)).data.memberIds.size()
          && next.lastChatAt is timestamp
          && next.lastChatAt == message.data.createdAt
          && (resource.data.get('lastChatAt', null) == null || next.lastChatAt >= resource.data.lastChatAt);
      }
      allow update: if signedIn() && (contentChange() || noticeChange() || refinementChange() || interestChange() || contributionChange() || participantChange() || discussionChange());
      allow delete: if false;

      match /interests/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list, update: if false;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time
          && getAfter(ideaPath(id)).data.interestCount == get(ideaPath(id)).data.interestCount + 1;
        allow delete: if signedIn() && request.auth.uid == uid
          && getAfter(ideaPath(id)).data.interestCount == get(ideaPath(id)).data.interestCount - 1;
      }
      match /contributions/{cid} {
        function contextValid(data) {
          let refinementId = data.get('refinementId', '');
          let replyTo = data.get('replyTo', '');
          return refinementId is string && refinementId.size() <= 128
            && replyTo is string && replyTo.size() <= 128
            && (refinementId == '' || exists(/databases/$(database)/documents/ideas/$(id)/refinements/$(refinementId)))
            && (replyTo == '' || (replyTo != cid
              && exists(/databases/$(database)/documents/ideas/$(id)/contributions/$(replyTo))
              && get(/databases/$(database)/documents/ideas/$(id)/contributions/$(replyTo)).data.get('refinementId', '') == refinementId));
        }
        allow get: if true;
        allow list: if bounded(50);
        allow create: if named(request.resource.data)
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'kind', 'text', 'createdAt', 'refinementId', 'replyTo'])
          && contextValid(request.resource.data)
          && request.resource.data.kind in ['경험', '질문', '제안']
          && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1200
          && request.resource.data.createdAt == request.time
          && getAfter(ideaPath(id)).data.lastContributionId == cid
          && getAfter(ideaPath(id)).data.contributionCount == get(ideaPath(id)).data.contributionCount + 1;
        allow update, delete: if false;
      }
      match /refinements/{rid} {
        allow get: if true;
        allow list: if bounded(20);
        allow create: if named(request.resource.data)
          && get(ideaPath(id)).data.get('postType', 'idea') != 'notice'
          && request.resource.data.keys().hasOnly(['title', 'audience', 'firstStep', 'sourceContributionId', 'authorId', 'authorName', 'createdAt'])
          && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 100
          && request.resource.data.audience is string && request.resource.data.audience.size() >= 1 && request.resource.data.audience.size() <= 600
          && request.resource.data.firstStep is string && request.resource.data.firstStep.size() >= 1 && request.resource.data.firstStep.size() <= 800
          && request.resource.data.sourceContributionId is string && request.resource.data.sourceContributionId.size() <= 128
          && (request.resource.data.sourceContributionId == '' || exists(/databases/$(database)/documents/ideas/$(id)/contributions/$(request.resource.data.sourceContributionId)))
          && request.resource.data.createdAt == request.time
          && getAfter(ideaPath(id)).data.lastRefinementId == rid
          && getAfter(ideaPath(id)).data.refinementCount == get(ideaPath(id)).data.get('refinementCount', 0) + 1;
        allow update, delete: if false;
      }
      match /activities/{aid} {
        allow get: if true;
        allow list: if bounded(30);
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['actorId', 'type', 'refId', 'createdAt'])
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && getAfter(ideaPath(id)).data.lastActivityAt == request.time
          && (
            (request.resource.data.type == 'interest' && request.resource.data.refId == request.auth.uid && aid == 'i_' + request.auth.uid
              && !exists(/databases/$(database)/documents/ideas/$(id)/interests/$(request.auth.uid))
              && getAfter(/databases/$(database)/documents/ideas/$(id)/interests/$(request.auth.uid)).data.createdAt == request.time)
            || (request.resource.data.type == 'contribution' && aid == 'c_' + request.resource.data.refId
              && getAfter(/databases/$(database)/documents/ideas/$(id)/contributions/$(request.resource.data.refId)).data.authorId == request.auth.uid
              && getAfter(/databases/$(database)/documents/ideas/$(id)/contributions/$(request.resource.data.refId)).data.createdAt == request.time)
            || (request.resource.data.type == 'refinement' && aid == 'r_' + request.resource.data.refId
              && getAfter(/databases/$(database)/documents/ideas/$(id)/refinements/$(request.resource.data.refId)).data.authorId == request.auth.uid
              && getAfter(/databases/$(database)/documents/ideas/$(id)/refinements/$(request.resource.data.refId)).data.createdAt == request.time)
          );
        allow update, delete: if false;
      }
      match /requests/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || owner(id));
        allow list: if owner(id) && bounded(20);
        // New discussion happens publicly; previously submitted requests remain private.
        allow create: if false;
        allow update: if owner(id) && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt'])
          && request.resource.data.decidedAt == request.time
          && (request.resource.data.status == 'declined'
            || (request.resource.data.status == 'accepted' && uid in getAfter(roomPath(id)).data.memberIds));
        allow delete: if false;
      }
    }

    match /rooms/{id} {
      // Owners may check that a new public thought has no room. Existing rooms stay member-only.
      allow get: if (owner(id) && !exists(roomPath(id))) || (signedIn() && request.auth.uid in resource.data.memberIds);
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds && bounded(20);
      allow create: if false;
      // Renaming a thought also renames its existing room; membership stays unchanged.
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title'])
        && getAfter(ideaPath(id)).data.title == request.resource.data.title;
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'lastAddedId'])
        && request.resource.data.memberIds is list && request.resource.data.memberIds.size() <= 20
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()) == [request.resource.data.lastAddedId].toSet()
        && resource.data.memberIds.toSet().difference(request.resource.data.memberIds.toSet()).size() == 0
        && get(/databases/$(database)/documents/ideas/$(id)/requests/$(request.resource.data.lastAddedId)).data.status == 'pending'
        && getAfter(/databases/$(database)/documents/ideas/$(id)/requests/$(request.resource.data.lastAddedId)).data.status == 'accepted';
      allow delete: if false;
      match /messages/{mid} {
        allow get: if member(id);
        allow list: if member(id) && bounded(50);
        allow create: if member(id) && named(request.resource.data)
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'text', 'createdAt'])
          && request.resource.data.text is string && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 800
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
